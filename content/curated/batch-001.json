  "senses": [
    {"id":"s-de-article-1","lexemeId":"lx-de-article","zh":"定冠词，相当于 the；用于 de 词（阳性、阴性名词）以及所有复数名词","examples":[{"nl":"De vrouw woont in de stad.","zh":"那位女士住在城里。"},{"nl":"De kinderen spelen in de tuin.","zh":"孩子们在花园里玩。"}],"collocations":["de man 那个男人","de kinderen 孩子们（复数一律用 de）"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-een-article-1","lexemeId":"lx-een-article","zh":"不定冠词，一个；某个（只用于单数，de 词和 het 词都用 een；复数不加冠词）","examples":[{"nl":"Ik heb een broer en een zus.","zh":"我有一个哥哥（弟弟）和一个姐姐（妹妹）。"},{"nl":"Hij koopt een nieuwe fiets.","zh":"他买一辆新自行车。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-hij-pronoun-1","lexemeId":"lx-hij-pronoun","zh":"他（主格人称代词）；口语中也可指 de 词的事物，相当于「它」","examples":[{"nl":"Hij werkt in een ziekenhuis.","zh":"他在一家医院工作。"},{"nl":"Waar is mijn tas? Hij ligt op tafel.","zh":"我的包在哪儿？它在桌上。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-ik-pronoun-1","lexemeId":"lx-ik-pronoun","zh":"我（第一人称单数，主格）","examples":[{"nl":"Ik woon in Utrecht.","zh":"我住在乌得勒支。"},{"nl":"Vandaag blijf ik thuis.","zh":"今天我待在家里。"}],"collocations":["ik denk dat … 我想……","ik weet het niet 我不知道"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-het-article-1","lexemeId":"lx-het-article","zh":"定冠词，相当于 the；用于 het 词（中性单数名词），以及所有指小的 -je 结尾名词","examples":[{"nl":"Het huis is groot.","zh":"这座房子很大。"},{"nl":"Ik lees het boek.","zh":"我在读这本书。"}],"collocations":["het meisje 那个女孩（-je 词一律用 het）"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-van-preposition-1","lexemeId":"lx-van-preposition","zh":"……的（表所属、关系）","examples":[{"nl":"Dit is de fiets van mijn zus.","zh":"这是我姐姐（妹妹）的自行车。"},{"nl":"Wie is de leraar van jouw kinderen?","zh":"你孩子们的老师是谁？"}],"collocations":["een vriend van mij 我的一个朋友","een stuk van de taart 一块蛋糕"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-van-preposition-2","lexemeId":"lx-van-preposition","zh":"从；来自（某人）；由……制成","examples":[{"nl":"Ik heb een brief van mijn moeder gekregen.","zh":"我收到了妈妈寄来的一封信。"},{"nl":"Deze tafel is van hout.","zh":"这张桌子是木头做的。"}],"collocations":["van … tot … 从……到……","houden van 喜欢，爱"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-ze-pronoun-1","lexemeId":"lx-ze-pronoun","zh":"她（弱读，主格或宾格）；指 de 词事物时也可译作「它」","examples":[{"nl":"Ze werkt op een school.","zh":"她在一所学校工作。"},{"nl":"Ik ken Anna goed. Ik zie ze elke week.","zh":"我很了解安娜。我每周都见她。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-ze-pronoun-2","lexemeId":"lx-ze-pronoun","zh":"他们；她们；它们（弱读复数，主格或宾格）","examples":[{"nl":"Ze komen morgen op bezoek.","zh":"他们明天来做客。"},{"nl":"Ik ken mijn buren niet. Ik zie ze bijna nooit.","zh":"我不认识我的邻居。我几乎从没见过他们。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-je-pronoun-1","lexemeId":"lx-je-pronoun","zh":"你（弱读主格或宾格，非正式；正式场合用 u）","examples":[{"nl":"Heb je morgen tijd?","zh":"你明天有空吗？"},{"nl":"Ik bel je vanavond.","zh":"我今晚给你打电话。"}],"collocations":["Hoe heet je? 你叫什么名字？"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-je-pronoun-2","lexemeId":"lx-je-pronoun","zh":"你的（物主限定词，弱读，后接名词）","examples":[{"nl":"Is dit je tas?","zh":"这是你的包吗？"},{"nl":"Hoe oud is je zus?","zh":"你姐姐（妹妹）多大了？"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-je-pronoun-3","lexemeId":"lx-je-pronoun","zh":"（泛指）人们；一个人，相当于英语 one / you","examples":[{"nl":"In Nederland moet je goed opletten op de fiets.","zh":"在荷兰骑车要多加小心。"},{"nl":"Hier kun je geen koffie kopen.","zh":"这里买不到咖啡。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-niet-adverb-1","lexemeId":"lx-niet-adverb","zh":"不；没（否定动词、形容词或整个句子）","examples":[{"nl":"Ik weet het niet.","zh":"我不知道。"},{"nl":"Dit boek is niet duur.","zh":"这本书不贵。"}],"collocations":["niet meer 不再","niet alleen … maar ook … 不仅……而且……","nog niet 还没有"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-het-pronoun-1","lexemeId":"lx-het-pronoun","zh":"它（指 het 词的事物，也可指已提到的事情）","examples":[{"nl":"Heb je het nieuwe boek gelezen? Ja, het is erg spannend.","zh":"你读过那本新书吗？读过，很精彩。"},{"nl":"Ik begrijp het niet.","zh":"我不明白。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-het-pronoun-2","lexemeId":"lx-het-pronoun","zh":"（虚主语）无具体所指，用于天气、时间、情况等","examples":[{"nl":"Het regent al de hele dag.","zh":"雨下了一整天。"},{"nl":"Het is half acht.","zh":"现在七点半。"}],"collocations":["het is koud 天气冷","het gaat goed 一切顺利"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-dat-pronoun-1","lexemeId":"lx-dat-pronoun","zh":"那；那个（指示代词，远指；单独使用，或修饰 het 词，如 dat huis）","examples":[{"nl":"Wat is dat?","zh":"那是什么？"},{"nl":"Ik vind dat huis erg mooi.","zh":"我觉得那座房子很漂亮。"}],"collocations":["dat is alles 就这些"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-dat-pronoun-2","lexemeId":"lx-dat-pronoun","zh":"（关系代词）……的；先行词是 het 词，或是 iets / alles 等","examples":[{"nl":"Het boek dat ik las, was heel leuk.","zh":"我读的那本书很有意思。"},{"nl":"Het huis dat ze kopen, ligt aan de rivier.","zh":"他们要买的那座房子在河边。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-die-pronoun-1","lexemeId":"lx-die-pronoun","zh":"那；那个；那些（指示代词；用于 de 词和所有复数，近指用 deze）","examples":[{"nl":"Wie is die man?","zh":"那个男人是谁？"},{"nl":"Die schoenen zijn te duur.","zh":"那些鞋太贵了。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-die-pronoun-2","lexemeId":"lx-die-pronoun","zh":"（关系代词）……的；先行词是 de 词或复数名词，指人或物","examples":[{"nl":"De man die naast mij woont, is dokter.","zh":"住在我隔壁的那个男人是医生。"},{"nl":"Ik heb vrienden die in Spanje wonen.","zh":"我有几个朋友住在西班牙。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-zijn-pronoun-1","lexemeId":"lx-zijn-pronoun","zh":"他的；它的（物主限定词，后接名词；注意与动词 zijn「是」同形）","examples":[{"nl":"Hij belt zijn moeder elke dag.","zh":"他每天给他妈妈打电话。"},{"nl":"De hond eet zijn eten op.","zh":"狗把它的食物吃完了。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-dat-conjunction-1","lexemeId":"lx-dat-conjunction","zh":"（从属连词）……的事；that，引导宾语从句等；从句中变位动词放在句末","examples":[{"nl":"Ik denk dat hij ziek is.","zh":"我想他生病了。"},{"nl":"Ik hoop dat je morgen komt.","zh":"我希望你明天来。"}],"collocations":["ik weet dat … 我知道……","het is jammer dat … 可惜……"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-te-preposition-1","lexemeId":"lx-te-preposition","zh":"（不定式标记）to，置于动词原形之前；可分动词写作 op te bellen","examples":[{"nl":"Ik probeer vroeg te slapen.","zh":"我尽量早点睡。"},{"nl":"Het is moeilijk om hem te begrijpen.","zh":"要理解他很难。"}],"collocations":["om … te + 动词原形 为了……","proberen te 尝试","beginnen te 开始"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-te-preposition-2","lexemeId":"lx-te-preposition","zh":"太（te + 形容词或副词，表示过度）","examples":[{"nl":"Deze soep is te warm.","zh":"这汤太烫了。"},{"nl":"Het is te laat om nu te bellen.","zh":"现在打电话太晚了。"}],"collocations":["te veel 太多","te laat 太晚；迟到"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-er-pronoun-1","lexemeId":"lx-er-pronoun","zh":"（存在句引导词）er is / er zijn：有；通常不译出","examples":[{"nl":"Er staat een boom in de tuin.","zh":"花园里有一棵树。"},{"nl":"Er zijn veel mensen op straat.","zh":"街上有很多人。"}],"collocations":["er is / er zijn 有"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-er-pronoun-2","lexemeId":"lx-er-pronoun","zh":"那里；在那儿（弱读的地点副词，指前面已提到的地方）","examples":[{"nl":"Ik woon in Rotterdam en ik werk er ook.","zh":"我住在鹿特丹，也在那里工作。"},{"nl":"Ben je morgen in Gent? Dan kom ik er ook heen.","zh":"你明天在根特吗？那我也过去。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-er-pronoun-3","lexemeId":"lx-er-pronoun","zh":"（与数量词连用）代替前面提到的名词，表示「其中的……」","examples":[{"nl":"Wil je een appel? Ik heb er nog drie.","zh":"你要苹果吗？我还有三个。"},{"nl":"Hij heeft veel boeken en ik heb er ook veel.","zh":"他有很多书，我也有很多。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-voor-preposition-1","lexemeId":"lx-voor-preposition","zh":"为了；给；对……来说；为……工作","examples":[{"nl":"Dit cadeau is voor jou.","zh":"这个礼物是给你的。"},{"nl":"Ik werk voor een groot bedrijf.","zh":"我在一家大公司工作。"}],"collocations":["voor het eerst 第一次","bedankt voor … 谢谢你……"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-voor-preposition-2","lexemeId":"lx-voor-preposition","zh":"在……之前；在……前面","examples":[{"nl":"Ik ben voor acht uur thuis.","zh":"我八点前到家。"},{"nl":"De auto staat voor het huis.","zh":"车停在房子前面。"}],"collocations":["voor het eten 饭前"],"topics":["语法","时间"],"level":"A1","review":"draft"},
    {"id":"s-haar-pronoun-1","lexemeId":"lx-haar-pronoun","zh":"她的（物主限定词，后接名词）","examples":[{"nl":"Ze belt haar vriendin.","zh":"她给她朋友打电话。"},{"nl":"Haar huis is erg groot.","zh":"她的房子很大。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-haar-pronoun-2","lexemeId":"lx-haar-pronoun","zh":"她（宾格，强读；弱读时用 ze）","examples":[{"nl":"Ik ken haar niet.","zh":"我不认识她。"},{"nl":"Ik geef haar een boek.","zh":"我给她一本书。"}],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-veel-pronoun-1","lexemeId":"lx-veel-pronoun","zh":"许多；很多（修饰不可数名词或复数名词；比较级 meer，最高级 meest）","examples":[{"nl":"Er zijn veel mensen in de trein.","zh":"火车上有很多人。"},{"nl":"Ik heb niet veel tijd.","zh":"我没有太多时间。"}],"collocations":["heel veel 非常多","te veel 太多","veel plezier 玩得开心"],"topics":["数量","语法"],"level":"A1","review":"draft"},
    {"id":"s-aan-preposition-1","lexemeId":"lx-aan-preposition","zh":"给；向（aan + 间接宾语）","examples":[{"nl":"Ik schrijf een brief aan mijn vriend.","zh":"我给我朋友写一封信。"},{"nl":"Wil je dit aan haar geven?","zh":"你能把这个交给她吗？"}],"collocations":["denken aan 想到","vragen aan 问（某人）"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-aan-preposition-2","lexemeId":"lx-aan-preposition","zh":"在……上；挂在、靠在……（表示附着或紧邻）","examples":[{"nl":"Het schilderij hangt aan de muur.","zh":"画挂在墙上。"},{"nl":"We zitten aan tafel.","zh":"我们坐在桌旁。"}],"collocations":["aan tafel 在桌旁","aan het werk zijn 正在工作"],"topics":["语法"],"level":"A1","review":"draft"},
    {"id":"s-dan-adverb-1","lexemeId":"lx-dan-adverb","zh":"那么；然后；到那时","examples":[{"nl":"Eerst eten we, dan gaan we naar huis.","zh":"我们先吃饭，然后回家。"},{"nl":"Als je moe bent, ga dan naar bed.","zh":"如果你累了，那就去睡觉吧。"}],"collocations":["tot dan 到时候见","wat dan? 那又怎样？"],"topics":["语法","时间"],"level":"A1","review":"draft"},
    {"id":"s-om-preposition-1","lexemeId":"lx-om-preposition","zh":"在（某个钟点）","examples":[{"nl":"De les begint om negen uur.","zh":"课九点开始。"},{"nl":"Om hoe laat eten we?","zh":"我们几点吃饭？"}],"collocations":["om half drie 两点半"],"topics":["时间","语法"],"level":"A1","review":"draft"},
    {"id":"s-om-preposition-2","lexemeId":"lx-om-preposition","zh":"（om … te + 动词原形）为了；以便","examples":[{"nl":"Ik ga naar de winkel om brood te kopen.","zh":"我去商店买面包。"},{"nl":"Hij leert Nederlands om hier te kunnen werken.","zh":"他学荷兰语是为了能在这里工作。"}],"topics":["语法"],"level":"A1","review":"draft"},
